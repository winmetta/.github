{
  // Shared Win Metta VS Code workspace. Open it from where it lives:
  //   code .github/winmetta.code-workspace   (run from the workspace root)
  // Do not symlink it into the workspace root: VS Code resolves symlinks, so "." is
  // always the .github folder and the other repos are its siblings (../<repo>).
  // Recommended extensions live in .vscode/extensions.json.
  "folders": [
    {
      "name": ".github",
      "path": ".",
    },
    {
      "name": "winmetta-platform",
      "path": "../winmetta-platform",
    },
    {
      "name": "bootstrap-dev-env",
      "path": "../bootstrap-dev-env",
    },
  ],
  "settings": {
    // Whitespace and line endings come from the shared .editorconfig.
    "files.eol": "\n",
    "files.insertFinalNewline": true,

    // Format on save, but only with the formatter each repo configures.
    "editor.formatOnSave": true,
    "prettier.requireConfig": true,
    "[shellscript]": {
      "editor.defaultFormatter": "mkhl.shfmt",
    },
    "[markdown]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[astro]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },

    // The workspace root holds many repos; find each repo's ESLint config.
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.validate": ["javascript", "typescript", "typescriptreact", "astro"],

    // markdownlint rules live in the shared .markdownlint.json.

    // Keep search and the file watcher fast across many repos.
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.astro": true,
      "**/.turbo": true,
      "**/test-results": true,
      "**/playwright-report": true,
      "**/package-lock.json": true,
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/dist/**": true,
      "**/.astro/**": true,
      "**/.turbo/**": true,
      "**/.git/objects/**": true,
    },

    // Find the nested repos for Source Control.
    "git.repositoryScanMaxDepth": 2,
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Bootstrap dev environment (shared tools)",
        "type": "shell",
        "options": { "cwd": "${workspaceFolder:.github}/.." },
        "command": "./bootstrap-dev-env/bootstrap.sh",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated" },
      },
      {
        "label": "Set up winmetta-platform",
        "type": "shell",
        "options": { "cwd": "${workspaceFolder:.github}/.." },
        "command": "./winmetta-platform/scripts/setup-local-dev.sh",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "dedicated" },
      },
      {
        "label": "Lint shell scripts (shellcheck + shfmt)",
        "type": "shell",
        "options": { "cwd": "${workspaceFolder:.github}/.." },
        "command": "shellcheck -s bash -x -P SCRIPTDIR .github/*.sh .github/scripts/*.sh bootstrap-dev-env/bootstrap.sh bootstrap-dev-env/lib/*.sh bootstrap-dev-env/platforms/*.sh winmetta-platform/scripts/*.sh && shfmt -d .github/*.sh .github/scripts/*.sh bootstrap-dev-env/bootstrap.sh bootstrap-dev-env/lib bootstrap-dev-env/platforms winmetta-platform/scripts/*.sh",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "shared" },
      },
      {
        "label": "Check Markdown (markdownlint + prettier)",
        "type": "shell",
        "options": { "cwd": "${workspaceFolder:.github}/.." },
        "command": "markdownlint-cli2 '.github/*.md' 'bootstrap-dev-env/*.md' 'bootstrap-dev-env/platforms/*.md' && prettier --check '.github/*.md' 'bootstrap-dev-env/*.md' 'bootstrap-dev-env/platforms/*.md'",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "shared" },
      },
      {
        "label": "Fix and format Markdown (markdownlint --fix + prettier)",
        "type": "shell",
        "options": { "cwd": "${workspaceFolder:.github}/.." },
        "command": "markdownlint-cli2 --fix '.github/*.md' 'bootstrap-dev-env/*.md' 'bootstrap-dev-env/platforms/*.md'; prettier --write '.github/*.md' 'bootstrap-dev-env/*.md' 'bootstrap-dev-env/platforms/*.md'",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "shared" },
      },
    ],
  },
}
